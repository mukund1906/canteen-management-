rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student aur owner accounts: ek-ek karke padh sakte hain, poori list nahi dikhti.
    // Account ban jaane ke baad badla nahi ja sakta.
    match /accounts/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    match /orders/{id}   { allow read, write: if true; }
    match /menu/{id}     { allow read, write: if true; }
    match /photos/{id}   { allow read, write: if true; }
    match /items/{id}    { allow read, write: if true; }
    match /removed/{id}  { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
  }
}
