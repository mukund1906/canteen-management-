rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student accounts: ek-ek karke padh sakte hain, poori list nahi dikhti.
    // Account banana / password reset sirf tab jab us mobile number ka OTP verify ho chuka ho.
    match /accounts/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      // Password reset sirf tab jab us mobile number ka OTP verify ho chuka ho.
      allow update: if request.auth != null
        && request.auth.token.phone_number == '+91' + resource.data.mobile
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salt', 'hash', 'resetAt']);
      allow delete: if false;
    }

    match /orders/{id}   { allow read, write: if true; }
    match /menu/{id}     { allow read, write: if true; }
    match /photos/{id}   { allow read, write: if true; }
    match /items/{id}    { allow read, write: if true; }
    match /removed/{id}  { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
  }
}
