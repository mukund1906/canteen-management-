rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student aur owner accounts: ek-ek karke padh sakte hain, poori list nahi dikhti.
    // Account ban jaane ke baad badla nahi ja sakta.
    match /accounts/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      // Password reset: sirf salt/hash/resetAt badal sakte hain (owner temporary password deta hai).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salt', 'hash', 'resetAt']);
      allow delete: if false;
    }

    match /resetreqs/{id} { allow read, write: if true; }
    match /orders/{id}   { allow read, write: if true; }
    match /menu/{id}     { allow read, write: if true; }
    match /photos/{id}   { allow read, write: if true; }
    match /items/{id}    { allow read, write: if true; }
    match /removed/{id}  { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
  }
}
